# Copy to .env. Keep this file readable only by the service account.
DATABASE_PATH=./data/gateway.db
PORT=3000
HOST=127.0.0.1

# Remote and container admin access requires a separate token of at least 24 characters.
# Generate one with openssl rand -hex 32 and configure HTTPS at your reverse proxy.
# MCP_GATEWAY_ADMIN_TOKEN=
# MCP_GATEWAY_ADMIN_ORIGINS=https://admin.gateway.example
# MCP_GATEWAY_MCP_ORIGINS=https://client.example
# MCP_GATEWAY_PUBLIC_MCP_ORIGIN=https://mcp.gateway.example

# Explicitly allow private or plain HTTP backends that you operate.
# MCP_GATEWAY_PRIVATE_BACKEND_ORIGINS=https://backend.tailnet.example,http://127.0.0.1:9000
# MCP_BACKEND_SECRET_EXAMPLE=
# Existing installations preserve audit history until you configure a limit.
# New installations default to 30 days and 100000 rows. Set either limit to 0 to disable it.
# MCP_GATEWAY_AUDIT_RETENTION_DAYS=30
# MCP_GATEWAY_AUDIT_MAX_ROWS=100000
# MCP_GATEWAY_CAPTURE_AUDIT_ARGS=0

# Optional isolated, interactive routes in endpoint:backend pairs.
# MCP_GATEWAY_INTERACTIVE_ROUTES=my-endpoint:trusted-backend
# MCP_GATEWAY_SANDBOX_BACKENDS=untrusted-connector
# MCP_GATEWAY_STDIO_LAUNCHER=/usr/local/bin/mcp-stdio-bwrap

# Optional external OAuth issuer for specific endpoint slugs.
# MCP_GATEWAY_OAUTH_ENDPOINTS=oauth-endpoint
# MCP_GATEWAY_OAUTH_RESOURCE_ORIGIN=https://mcp.gateway.example
# MCP_GATEWAY_OAUTH_ISSUER=https://id.example
# MCP_GATEWAY_OAUTH_JWKS_URL=https://id.example/jwks
# MCP_GATEWAY_OAUTH_INTROSPECTION_URL=https://id.example/introspect
# MCP_GATEWAY_OAUTH_INTROSPECTION_ID=
# MCP_GATEWAY_OAUTH_INTROSPECTION_SECRET=
