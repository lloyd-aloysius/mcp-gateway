# Copy this file to .env and adjust as needed. All values have sane defaults.

# Where the SQLite database file lives (created automatically on first run)
DATABASE_PATH=./data/gateway.db

# Host/port next start binds to in production (npm run build && npm start).
# Defaults to loopback-only — safest for a dashboard with no login.
# Only change HOST if you understand the risk (see Settings page in-app for a warning).
PORT=3000
HOST=127.0.0.1
